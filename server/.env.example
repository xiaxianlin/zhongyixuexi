DATABASE_URL=postgres://user:password@localhost:5432/zhongyixuexi
PORT=4000

# Signs member/admin session tokens — any long random string, keep secret.
JWT_SECRET=change-me-to-a-long-random-string

# First-run only: creates one admin account if the users table is empty and
# these are both set (invite-code registration has no way to create the
# first admin who can then generate invite codes for everyone else).
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Platform-held DeepSeek credential for AI-01 (paragraph analysis, not yet
# ported to this server) and AI-05 (chat). No per-user BYOK.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Global rate-limit ceiling (requests/minute/IP). /auth/* and /chat have
# their own stricter per-route limits regardless of this value.
RATE_LIMIT_MAX=300
